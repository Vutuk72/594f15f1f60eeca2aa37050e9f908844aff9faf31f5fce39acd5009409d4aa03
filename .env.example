# Vzor proměnných pro docker-compose. Zkopíruj na .env a uprav (hlavně heslo).
# .env se necommituje, .env.example ano.
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=zmen-me

# Správce Keycloaku (admin konzole na http://localhost:8180)
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=zmen-me
