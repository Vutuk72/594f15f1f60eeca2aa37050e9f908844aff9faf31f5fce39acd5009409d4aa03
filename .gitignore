# Pozor: komentář musí být na samostatném řádku – git nepodporuje komentáře za pravidlem.

# .NET
# zkompilované soubory .NET backendu
bin/
# dočasné soubory z buildu .NET
obj/
# nastavení Visual Studia
.vs/
# osobní nastavení projektu ve Visual Studiu
*.user

# Angular / Node
# stažené knihovny pro Angular (stovky MB)
node_modules/
# sestavená verze Angularu
dist/
# cache Angular CLI
.angular/

# IDE
# nastavení Rideru / IntelliJ
.idea/
# nastavení VS Code
.vscode/

# Tajné údaje
# soubor s hesly (třeba do databáze pro Docker Compose) – commituje se jen .env.example
.env
